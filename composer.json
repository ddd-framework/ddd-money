{
    "name": "mgamadeus/ddd-common-money",
    "description": "Currency and MoneyAmount value objects for mgamadeus/ddd",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-money",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-money/issues",
        "source": "https://github.com/ddd-framework/ddd-money"
    },
    "version": "1.2.4",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd": "^3.40.0"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\Money\\MoneyModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\Money\\": "tests/"
        }
    }
}
